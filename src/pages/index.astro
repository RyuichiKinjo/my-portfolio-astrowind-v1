---
import Layout from '~/layouts/PageLayout.astro';

import Header from '~/components/widgets/Header.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import Projects from '~/components/widgets/Projects.astro';
import Features3 from '~/components/widgets/Features3.astro';
// import Testimonials from '~/components/widgets/Testimonials.astro';
import Steps from '~/components/widgets/Steps.astro';
// import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import { getPermalink } from '~/utils/permalinks';
import careerData from '~/data/career.json';

interface CareerSkill {
  name: string;
  level?: string;
  experienceYears?: number;
  category?: string;
}

interface Career {
  profile: {
    qualifications: string[];
  };
  skillCategories: {
    category: string;
    skills: CareerSkill[];
  }[];
  projects: {
    title: string;
    period: string;
    industry: string;
    role: string;
    teamSize?: string;
    phases: string[];
    technologies: Record<string, string[] | undefined>;
    description: string;
  }[];
}

const career = careerData as Career;

const techLabels: Record<string, string> = {
  languages: '言語',
  frameworks: 'フレームワーク',
  databases: 'データベース',
  tools: 'ツール',
  environment: '環境',
};

const escapeHtml = (value: string) =>
  value.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;');

const visibleWorkExperienceCount = 3;

const workExperienceItems = [
  ...career.projects.map((project) => {
    const meta = [project.role, project.industry, project.teamSize ? `チーム ${project.teamSize}` : '']
      .filter(Boolean)
      .join(' / ');
    const phases = project.phases.length > 0 ? `工程: ${project.phases.join('、')}` : '';
    const technologies = Object.entries(project.technologies)
      .filter((entry): entry is [string, string[]] => Array.isArray(entry[1]) && entry[1].length > 0)
      .map(([key, values]) => `${techLabels[key] ?? key}: ${values.map((value) => escapeHtml(value)).join('、')}`)
      .join('<br />');

    return {
      title: `${escapeHtml(project.title)}<br /><span class="font-normal">${escapeHtml(meta)}</span><br /><span class="text-sm font-normal">${escapeHtml(project.period)}</span>`,
      description: [escapeHtml(project.description), escapeHtml(phases), technologies].filter(Boolean).join('<br />'),
      icon: 'tabler:briefcase',
    };
  }),
  {
    title: 'and more...',
    description:
      '2007年よりエンジニアとして活動しています。',
    icon: 'tabler:dots',
    classes: { title: 'text-lg font-semibold' },
  },
];

const skillItems = [
  ...career.skillCategories.map((category) => ({
    title: category.category,
    description: category.skills
      .map((skill) => {
        const details = [
          skill.level,
          skill.experienceYears ? `${skill.experienceYears}年` : '',
          skill.category,
        ].filter(Boolean);
        const label = details.length > 0 ? `${skill.name}（${details.join(' / ')}）` : skill.name;
        return escapeHtml(label);
      })
      .join('<br />'),
  })),
  {
    title: 'Qualifications',
    description: career.profile.qualifications.map((name) => escapeHtml(name)).join('<br />'),
  },
];

const metadata = {
  title: 'RK Playground',
  ignoreTitleTemplate: true,
  description: '金城竜一のポートフォリオ。システムエンジニア / Web開発。',
};
---

<Layout metadata={metadata}>
  <Fragment slot="announcement"></Fragment>
  <Fragment slot="header">
    <Header
      links={[
        { text: 'Home', href: '#' },
        { text: 'About me', href: '#about' },
        { text: 'Work experience', href: '#resume' },
        { text: 'Skills', href: '#skills' },
        { text: 'Portfolio', href: '#portfolio' },
        // { text: 'Blog', href: '#blog' },
        { text: 'Github', href: 'https://github.com/RyuichiKinjo' },
      ]}
      actions={[
        {
          text: 'Hire me',
          href: '#',
        },
      ]}
      isSticky
      showToggleTheme
    />
  </Fragment>

  <!-- Hero2 Widget ******************* -->

  <Hero
    id="hero"
    title="金城　竜一"
    tagline="Ryuichi Kinjo"
    classes={{ title: 'text-3xl md:text-4xl' }}
    actions={[{ variant: 'primary', text: 'Hire me', href: getPermalink('/contact#form') }]}
  >
    <Fragment slot="subtitle">
      システムエンジニア / Web開発<br />
      主にJavaを使用した業務アプリ開発を行っています。<br />
      最近はNext.jsやAstroを使ったモダンなWebサイト・アプリを開発したり、<br />CursorでAIプログラミングも行っています。
      <p class="mt-6 mb-2 font-bold text-heading">このサイトの使用技術</p>
      <ul class="mx-auto w-max max-w-full list-disc pl-5 text-left">
        <li>フロントエンド： Astro, Tailwind CSS, TypeScript</li>
        <li>バックエンド： -</li>
        <li>インフラ： Vercel</li>
        <li>ツール： Git, GitHub, Cursor</li>
      </ul>
    </Fragment>
  </Hero>

  <!-- Content Widget **************** -->
  
  <Content
    id="about"
    columns={3}
    items={[
      /*
      {
        icon: 'tabler:brand-dribbble',
        callToAction: {
          target: '_blank',
          text: 'Dribbble',
          href: '#',
        },
      },
      {
        icon: 'tabler:brand-behance',
        callToAction: {
          target: '_blank',
          text: 'Behance',
          href: '#',
        },
      },
      {
        icon: 'tabler:brand-pinterest',
        callToAction: {
          target: '_blank',
          text: 'Pinterest',
          href: '#',
        },
      },
      */
    ]}
    image={{
      src: '~/assets/images/profile_image.jpg',
      alt: 'Colorful Image',
      loading: 'eager',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">About me</h2>
      <p>
        10数年ほどフリーランスのシステムエンジニアを行っております。
      <br />
        要件定義などの上流工程からリリースまで、一貫して対応することを得意としております。
      <br />
        様々な業種でJavaを軸にバックエンドからフロントエンドまで幅広く経験してきました。
      <br />
        主にリーダーやサブリーダーを担うことが多いですが、特定の立場に固執せず、プロジェクトの状況に応じて柔軟に対応することや、顧客や関係者とのスムーズな調整や若手のサポートなど、チーム全体で成功を収めるための環境づくりを心がけています。
      <br />
        最近は Next.js や Astro、Cursor などの AI ツールを活用したモダンな開発スキルのキャッチアップも楽しんでいます。
      <br />
        学生時代は野球に打ち込んでいました、趣味は旅行、街ブラ、温泉、料理、ギター、釣り、お酒です！
      <br />
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->

  <Steps
    id="resume"
    title="Work experience"
    items={workExperienceItems}
    initiallyVisible={visibleWorkExperienceCount}
    classes={{ container: 'max-w-3xl' }}
  />

  <!-- Steps Widget ******************
  <Steps
    id="education"
    title="Education"
    items={[
      {
        title: `Master of Fine Arts in Graphic Design <br /> <span class="font-normal">New York University's School of Design</span> <br /> <span class="text-sm font-normal">2018 - 2020</span>`,
        icon: 'tabler:school',
      },
      {
        title: `Bachelor of Arts in Graphic Design <br /> <span class="font-normal">New York University's School of Design</span> <br /> <span class="text-sm font-normal">2014 - 2018</span>`,
        icon: 'tabler:school',
      },
    ]}
    classes={{ container: 'max-w-3xl' }}
  />
  -->

  <!-- Features3 Widget ************** -->

  <Features3
    id="skills"
    title="Skills"
    subtitle="業務システム開発で使ってきた言語、フレームワーク、データベース、ミドルウェアと、保有資格です。"
    columns={2}
    defaultIcon="tabler:point-filled"
    items={skillItems}
  />

  <!-- Projects Widget **************** -->

  <Projects
    id="portfolio"
    title="Portfolio"
    subtitle="自分で作ったWebサイトを、ここから紹介します。カードの href に公開したURLを入れると、そのサイトへリンクします。"
    items={[
      {
        title: 'Yahoo!ニュース',
        description:
          '国内・海外の最新ニュースからエンタメ、スポーツまで、話題の記事をまとめて読めるニュースサイトです。',
        tags: ['ニュース', 'メディア'],
        href: 'https://news.yahoo.co.jp/',
        linkText: 'Yahoo!ニュースを見る',
      },
    ]}
  />

  <!-- Testimonials Widget ***********
  <Testimonials
    title="Client testimonials"
    subtitle="Discover what clients have to say about their experiences working with me."
    testimonials={[
      {
        testimonial: `She took our vague concept and turned it into a visual masterpiece that perfectly aligned with our goals. Her attention to detail and ability to translate ideas into compelling visuals exceeded our expectations.`,
        name: 'Mark Thompson',
        job: 'Creative director',
        image: {
          src: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80',
          alt: 'Mark Thompson Image',
        },
      },
    ]}
  />
  -->

  <!-- BlogLatestPost Widget ****************
  <BlogLatestPosts
    id="blog"
    title="Explore my insightful articles on my blog"
    information={`Dive into a realm of design wisdom and creative inspiration, where you'll find invaluable insights, practical tips, and captivating narratives that elevate and enrich your creative journey.`}
    count={1}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
  -->
</Layout>
